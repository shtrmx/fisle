# Пользователь/namespace на Docker Hub и версия образа <user>/fisle-game:<version>
DOCKERHUB_USER=shtrmx
FISLE_VERSION=latest

# Порт HTTP/WebSocket-сервера
PORT=3000

# Лимит активных комнат на сервере (0 = без лимита)
MAX_ROOMS=100

# Лимит активных комнат на одного игрока (0 = без лимита)
MAX_ROOMS_PER_PLAYER=3

# Ограничения ресурсов контейнера
CPU_LIMIT=1.0
MEMORY_LIMIT=512M
